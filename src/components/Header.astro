---
import { WEB_APP } from '../lib/links';
import Search from './Search.astro';

const isHome = Astro.url.pathname === '/';
---

<header class="sticky top-0 z-40 border-b border-border bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5 no-underline" aria-label="Tripomatic Help Center home">
      <img src="/logo_tripomatic_light.svg" alt="Tripomatic" width="126" height="30" class="hidden h-[30px] w-auto sm:block" />
      <img src="/logo_tripomatic_mark.svg" alt="Tripomatic" width="30" height="30" class="h-[30px] w-auto sm:hidden" />
      <span class="border-l border-border pl-2.5 text-[15px] font-medium text-muted">Help Center</span>
    </a>
    <div class="ml-auto flex items-center gap-3">
      {!isHome && <div class="hidden w-72 md:block"><Search compact /></div>}
      <a
        href={WEB_APP}
        class="rounded-full bg-navy px-4 py-2 text-sm font-bold text-white no-underline hover:bg-heading hover:text-white"
      >Open Tripomatic</a>
    </div>
  </div>
</header>
