---
import { articlePath, type Article } from '../lib/articles';
interface Props {
  /** Article to link to. */
  article: Article;
  /** Show the short answer under the title. */
  withDescription?: boolean;
}
const { article, withDescription = false } = Astro.props;
---

<a href={articlePath(article)} class="group flex items-start gap-3 rounded-xl px-3 py-3 no-underline hover:bg-bg-gray">
  <svg class="mt-1 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h5"></path></svg>
  <span>
    <span class="block font-bold text-heading group-hover:text-link">{article.data.title}</span>
    {withDescription && <span class="mt-0.5 block text-[15px] leading-snug text-text">{article.data.description}</span>}
  </span>
</a>
