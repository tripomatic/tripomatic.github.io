---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FeatureCta from '../../components/FeatureCta.astro';
import ArticleLink from '../../components/ArticleLink.astro';
import {
  allArticles,
  articleSlug,
  articlePath,
  articleMarkdownPath,
  PLATFORM_LABELS,
  TIER_LABELS,
  formatDate,
  type Article,
} from '../../lib/articles';
import { sectionById } from '../../lib/sections';
import { articleLd, breadcrumbs, faqLd } from '../../lib/jsonld';
import { SUPPORT_EMAIL } from '../../lib/links';

export async function getStaticPaths() {
  const articles = await allArticles();
  return articles.map((article) => ({
    params: { section: article.data.section, slug: articleSlug(article) },
    props: { article, articles },
  }));
}

interface Props {
  article: Article;
  articles: Article[];
}

const { article, articles } = Astro.props;
const { data } = article;
const section = sectionById(data.section);
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);
const siblings = articles.filter((a) => a.data.section === data.section);
const related = data.related
  .map((id) => {
    const found = articles.find((a) => a.id === id);
    if (!found) throw new Error(`${article.id}: related article "${id}" does not exist`);
    return found;
  });
const trail = [
  { name: section.title, href: `/${section.id}/` },
  { name: data.title, href: articlePath(article) },
];
const jsonLd = [articleLd(article), breadcrumbs(trail), ...(data.faq.length ? [faqLd(data.faq)] : [])];
const appName = section.app === 'tripomatic' ? 'Tripomatic' : 'Audio Guides';
---

<Base title={data.title} description={data.description} jsonLd={jsonLd} markdownPath={articleMarkdownPath(article)}>
  <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-8 sm:px-6 lg:grid-cols-[1fr_260px]">
    <article class="min-w-0">
      <Breadcrumbs items={trail} />
      <h1 class="mt-6 font-display text-[34px] leading-tight text-heading sm:text-[42px]">{data.title}</h1>
      <div class="mt-4 flex flex-wrap gap-2 text-[13px] font-bold">
        {data.platforms.map((p) => <span class="rounded-full bg-bg-gray px-3 py-1 text-muted">{PLATFORM_LABELS[p]}</span>)}
        <span class={`rounded-full px-3 py-1 ${data.tier === 'free' ? 'bg-[#e7f6ec] text-[#1d6b3a]' : 'bg-[#fdf0d8] text-[#8a5a00]'}`}>{TIER_LABELS[data.tier]}</span>
      </div>
      <div class="mt-7 rounded-2xl border border-border bg-bg-gray px-6 py-5">
        <p class="text-[13px] font-bold uppercase tracking-wider text-muted">Short answer</p>
        <p class="mt-1.5 text-[18px] leading-relaxed text-heading">{data.description}</p>
      </div>
      <div class="prose mt-8 max-w-none">
        <Content />
      </div>
      {data.faq.length > 0 && (
        <section class="mt-14" aria-labelledby="faq">
          <h2 id="faq" class="font-display text-[28px] text-heading">Common questions</h2>
          <div class="mt-5 divide-y divide-border rounded-2xl border border-border">
            {data.faq.map((item) => (
              <details class="group px-6 py-4">
                <summary class="cursor-pointer list-none font-bold text-heading marker:hidden">
                  <span class="flex items-center justify-between gap-4">{item.q}<span class="text-accent transition group-open:rotate-45" aria-hidden="true">+</span></span>
                </summary>
                <p class="mt-3">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
      <FeatureCta feature={data.feature} app={section.app} />
      <p class="mt-8 text-sm text-muted">
        Checked against {appName} {data.appVersion} on {formatDate(data.updated)}.
        Something here does not match what you see? Email <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(`Help article: ${data.title}`)}`}>{SUPPORT_EMAIL}</a>.
        · <a href={articleMarkdownPath(article)}>Markdown version</a>
      </p>
    </article>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      {toc.length > 1 && (
        <nav aria-label="On this page" class="mb-8 hidden lg:block">
          <p class="text-[13px] font-bold uppercase tracking-wider text-muted">On this page</p>
          <ul class="mt-3 space-y-2 border-l border-border text-[15px]">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-4 text-text no-underline hover:border-accent hover:text-heading">{h.text}</a></li>)}
          </ul>
        </nav>
      )}
      {related.length > 0 && (
        <div class="mb-8">
          <p class="px-3 text-[13px] font-bold uppercase tracking-wider text-muted">Related</p>
          <div class="mt-2">{related.map((a) => <ArticleLink article={a} />)}</div>
        </div>
      )}
      <div>
        <p class="px-3 text-[13px] font-bold uppercase tracking-wider text-muted">In {section.title}</p>
        <div class="mt-2">
          {siblings.filter((a) => a.id !== article.id).map((a) => <ArticleLink article={a} />)}
        </div>
      </div>
    </aside>
  </div>
</Base>
