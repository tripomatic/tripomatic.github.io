---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
---

<Base title="Page not found" description="This help page does not exist or has moved." noindex>
  <div class="mx-auto max-w-2xl px-4 pt-20 text-center sm:px-6">
    <h1 class="font-display text-[40px] text-heading">This page has moved</h1>
    <p class="mt-4 text-lg">We rebuilt the Help Center and some old articles were merged or retired. Search for what you need:</p>
    <div class="mt-8 text-left"><Search /></div>
    <p class="mt-8"><a href="/">Go to the Help Center home</a></p>
  </div>
</Base>
